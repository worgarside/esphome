# Copy to secrets.yaml for local validation / Device Builder.
# secrets.yaml is gitignored — do not commit real credentials.

wifi_ssid: "example-ssid"
wifi_password: "example-password"
ota_password: "example-ota-password"

# 32-byte base64 keys (zeros) — replace with real values from `openssl rand -base64 32`
api_encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
esp32_bluetooth_proxy_api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
esp32_joroto_bike_api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
